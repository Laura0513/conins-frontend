# CONINS — Backend environment variables
# Copia este archivo como .env y completa los valores para tu entorno local.
# NUNCA commitees el archivo .env real.

# ── Servidor ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Base de datos MySQL (Laragon por defecto) ─────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=conIns

# ── JWT ───────────────────────────────────────────────────
# Cambia este valor en produccion por una cadena aleatoria larga.
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=24h

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Correo (Nodemailer) — opcional ────────────────────────
# Dejar vacio si no hay SMTP: el sistema funciona sin correo
# (las notificaciones internas siguen operando).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=conins@sena.edu.co

# ── Administrador / acceso de emergencia (break-glass) ────
# El Administrador es un usuario REAL de la BD (admin@conins.sena, rol
# Administrador). Su clave inicial coincide con SUPER_USER_PASSWORD.
# Estas variables son ademas el acceso de EMERGENCIA: el login las usa solo si
# NO existe un usuario con ese correo en la BD. En el handout al centro, la
# persona de soporte cambia la clave desde la app; en produccion se pueden
# vaciar estas variables.
SUPER_USER=admin@conins.sena
SUPER_USER_PASSWORD=Admin2026!
