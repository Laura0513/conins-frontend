{
  "name": "conins-backend",
  "version": "1.0.0",
  "description": "CONINS API REST — SENA CDMC",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --ignore \"**/*.log\" server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:backup": "cd scripts && db-backup.bat",
    "db:restore": "cd scripts && db-restore.bat"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.19.1",
    "nodemailer": "^6.10.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
