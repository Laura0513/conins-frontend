# CONINS — Backend environment variables
# Copia este archivo como .env y completa los valores para tu entorno local.
# NUNCA commitees el archivo .env real.

# ── Servidor ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Base de datos MySQL (Laragon por defecto) ─────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=conIns

# ── JWT ───────────────────────────────────────────────────
# Cambia este valor en produccion por una cadena aleatoria larga
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=24h

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Correo (Nodemailer) ───────────────────────────────────
# Dejar vacio si no tienes SMTP configurado.
# El sistema funciona sin correo — las notificaciones internas siguen operando.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=conins@sena.edu.co

# ── Super usuario (solo entorno local de desarrollo) ──────
# Cuenta de emergencia para acceder al sistema sin pasar por BD.
# En produccion dejar vacio o eliminar estas variables.
SUPER_USER=admin@conins.sena
SUPER_USER_PASSWORD=
